// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int      @id @default(autoincrement())
  account         String   @unique
  password        String
  name            String
  role            String   @default("user")
  status          Boolean  @default(true)
  createTime      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  dingTalkOpenId  String?  @unique
  organizations   Organization[]
  bookings        Booking[]
  sessions        Session[]
  feedbacks       Feedback[]
  notices         Notice[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// 老师表
model Teacher {
  id              Int      @id @default(autoincrement())
  name            String
  account         String?  @unique
  password        String?
  dingTalkOpenId  String?  @unique
  status          String   @default("pending") // pending/active/disabled
  createTime      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organizations   TeacherOrganization[]
  bookings        Booking[]
  sessions        TeacherSession[]

  @@index([dingTalkOpenId])
  @@map("teachers")
}

// 老师会话表
model TeacherSession {
  id        String   @id
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([teacherId])
  @@map("teacher_sessions")
}

// 老师-部门关联表
model TeacherOrganization {
  teacherId      Int
  organizationId Int
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([teacherId, organizationId])
  @@map("teacher_organizations")
}

// 学生表
model Student {
  id          Int      @id @default(autoincrement())
  name        String
  studentId   String   @unique
  account     String?  @unique
  password    String?
  seewoOpenId String?  @unique
  status      String   @default("active") // active/disabled
  createTime  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bookings    Booking[]
  sessions    StudentSession[]

  @@index([seewoOpenId])
  @@map("students")
}

// 学生会话表
model StudentSession {
  id        String   @id
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("student_sessions")
}

model Organization {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  description     String?
  users           User[]
  teachers        TeacherOrganization[]
  bookings        Booking[]
  invitationCodes InvitationCode[]
  createTime      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("organizations")
}

model InvitationCode {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  role           String       @default("user")
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  expiresAt      DateTime?
  maxUses        Int          @default(1)
  usedCount      Int          @default(0)
  status         Boolean      @default(true)
  createTime     DateTime     @default(now())

  @@map("invitation_codes")
}

model Room {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  capacity    Int?
  location    String?
  description String?
  status      Boolean  @default(true)
  bookings    Booking[]
  createTime  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("rooms")
}

model Booking {
  id             Int          @id @default(autoincrement())
  roomId         Int
  room           Room         @relation(fields: [roomId], references: [id])
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         Int?
  user           User?        @relation(fields: [userId], references: [id])
  teacherId      Int?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id])
  studentId      Int?
  student        Student?     @relation(fields: [studentId], references: [id])
  startTime      DateTime
  endTime        DateTime
  purpose        String
  remark         String?
  status         String       @default("pending")
  createTime     DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([teacherId])
  @@index([studentId])
  @@map("bookings")
}

model AutoApprovalRule {
  id             Int      @id @default(autoincrement())
  name           String
  organizationId Int?
  roomId         Int?
  userId         Int?
  maxDuration    Int?
  startHour      String?
  endHour        String?
  
  action         String   @default("approve")
  status         Boolean  @default(true)
  createTime     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("auto_approval_rules")
}

model Feedback {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  type       String
  content    String
  status     String   @default("pending")
  reply      String?
  createTime DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("feedbacks")
}

model Notice {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  showPopup  Boolean  @default(false)
  creatorId  Int
  creator    User     @relation(fields: [creatorId], references: [id])
  createTime DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notices")
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("system_settings")
}

