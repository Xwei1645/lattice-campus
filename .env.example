# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=wzhs_booking

# Prisma 连接串 (本地开发使用)
DATABASE_URL="postgresql://postgres:your_strong_password_here@localhost:5432/wzhs_booking"

# PostgreSQL 工具路径 (备份功能需要)
# Windows 示例: C:\Program Files\PostgreSQL\16\bin
# Linux/Mac 示例: /usr/lib/postgresql/16/bin
# 如果已添加到系统 PATH，可留空
PG_BIN_PATH=""

# 钉钉配置
DINGTALK_CLIENT_ID=""
DINGTALK_CLIENT_SECRET=""
DINGTALK_REDIRECT_URI="http://localhost:3000/login"
